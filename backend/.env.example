# Set these in the backend host's environment-variable dashboard. Do not commit .env.
DEEPGRAM_API_KEY=your_deepgram_api_key

# Gemini API Keys (Single key or comma-separated pool for circular quota rotation)
GEMINI_API_KEY=your_primary_gemini_api_key
# Optional multi-key rotation pool (comma-separated or GEMINI_API_KEY_1, GEMINI_API_KEY_2, etc.):
GEMINI_API_KEYS=key1,key2,key3,key4

# Comma-separated frontend origins, including the Vercel production domain.
CORS_ORIGINS=https://your-project.vercel.app
